{
  "name": "jacbos-casino",
  "version": "0.1.0",
  "private": true,
  "description": "Jacbos Casino — Blackjack & Texas Hold'em with a 3D AI dealer, single-player and real-time multiplayer.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w @casino/server\" \"npm run dev -w @casino/client\"",
    "dev:client": "npm run dev -w @casino/client",
    "dev:server": "npm run dev -w @casino/server",
    "build": "npm run build -w @casino/client && node scripts/build-server.mjs",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "cross-env SLOW=1 vitest run --testTimeout=600000",
    "test:e2e": "playwright test",
    "load": "tsx scripts/load-smoke.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
